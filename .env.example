# Copy this file to .env and fill in a real key:   cp .env.example .env
# .env is listed in .gitignore and must NEVER be committed.
#
# One key is REQUIRED to run any LLM-backed CAMEL agent (the role-playing
# demo, ChatAgent, etc.): the key for whichever platform you choose below.
# Without a key, only the offline stub-model smoke test runs:
#   python demo/role_playing_demo.py --stub

# ---- 1. Choose a model platform (default: openai) ----
# Each team member can use a different provider; nothing in the code changes.
# Groq, Gemini and Cerebras offer free tiers. Ollama runs locally with no key.
# MODEL_PLATFORM=openai
# MODEL_PLATFORM=groq
# MODEL_PLATFORM=gemini
# MODEL_PLATFORM=ollama

# ---- 2. Optionally pick a model on that platform (default per platform in demo/role_playing_demo.py) ----
# MODEL_NAME=gpt-4.1-mini-2025-04-14      # openai
# MODEL_NAME=openai/gpt-oss-120b          # groq (its Llama 3.x models were retired 2026-08-16)
# MODEL_NAME=gemini-2.5-flash             # gemini
# MODEL_NAME=openrouter/free              # openrouter: auto-routes to a currently free model
# MODEL_NAME=llama3.1:8b                  # ollama (run `ollama pull llama3.1:8b` first)

# ---- 3. The key for your platform (only the one you use) ----
OPENAI_API_KEY=sk-your-key-here          # https://platform.openai.com/api-keys
# GROQ_API_KEY=                          # https://console.groq.com/keys  (free tier)
# GEMINI_API_KEY=                        # https://aistudio.google.com/apikey  (free tier)
# OPENROUTER_API_KEY=                    # https://openrouter.ai/keys  (free models available; the hosted Playground uses this)
# CEREBRAS_API_KEY=                      # https://cloud.cerebras.ai  ($5 trial credits, expire after 30 days; no permanent free tier)
# ANTHROPIC_API_KEY=                     # https://console.anthropic.com
# Ollama needs no key; optional: OLLAMA_BASE_URL=http://localhost:11434/v1
